{
  "name": "@kripl/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@kripl/app-state": "0.0.1",
    "@kripl/context-runtime": "0.0.1",
    "@kripl/core": "0.0.1",
    "@kripl/local-openai-provider": "0.0.1",
    "@kripl/pi-adapter": "0.0.1",
    "@kripl/terminal": "0.0.1",
    "@kripl/workspace": "0.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "studio.kripl.app",
    "productName": "Kripl Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false,
    "nativeRebuilder": "sequential",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "MaxSquizie",
      "repo": "Kripl-Studio"
    }
  }
}